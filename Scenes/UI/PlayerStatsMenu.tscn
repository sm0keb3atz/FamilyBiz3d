[sub_resource type="Shader" id="Shader_backdrop"]
code = "shader_type canvas_item;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;\n\nvoid fragment() {\n\tvec4 scene = textureLod(screen_texture, SCREEN_UV, 3.2);\n\tvec3 graded = mix(scene.rgb, vec3(0.018, 0.027, 0.038), 0.58);\n\tCOLOR = vec4(graded, 0.93);\n}\n"

